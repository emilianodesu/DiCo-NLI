\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Directional Transition Matrices for Track 1 (English) comparing Baseline vs.\ Symmetrized Decoding. Rows indicate prediction on $(A, B)$; columns indicate prediction on $(B, A)$. Bold numbers indicate consistent involution targets; underlined values indicate Reversal Curse loops. Notice that in the Baseline model, 5 pairs collapsed into spurious negative symmetry, whereas Symmetrized Decoding concentrates all predictions on valid semantic pairs with $100\%$ SoftCons.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:transition_matrices}{{2}{7}{Directional Transition Matrices for Track 1 (English) comparing Baseline vs.\ Symmetrized Decoding. Rows indicate prediction on $(A, B)$; columns indicate prediction on $(B, A)$. Bold numbers indicate consistent involution targets; underlined values indicate Reversal Curse loops. Notice that in the Baseline model, 5 pairs collapsed into spurious negative symmetry, whereas Symmetrized Decoding concentrates all predictions on valid semantic pairs with $100\%$ SoftCons}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Confusion Matrices on Track 1 (English) validation split comparing Baseline versus Symmetrized Decoding. Symmetrized Decoding rescues \textsc  {Equivalence} recall from $0.000$ to $0.667$ and eliminates false negative predictions on entailed pairs, raising overall Weighted $F_1$ from $0.315$ to $0.548$.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:confusion_matrices}{{3}{7}{Confusion Matrices on Track 1 (English) validation split comparing Baseline versus Symmetrized Decoding. Symmetrized Decoding rescues \textsc {Equivalence} recall from $0.000$ to $0.667$ and eliminates false negative predictions on entailed pairs, raising overall Weighted $F_1$ from $0.315$ to $0.548$}{table.3}{}}
